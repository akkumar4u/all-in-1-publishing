{
  "manifest_version": 3,
  "name": "Content Studio",
  "description": "Hub Publisher (DI Page Composer hub pages) + Auto Publishing (Google Doc → WordPress blog post), combined into one extension.",
  "version": "1.9.46",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "debugger",
    "offscreen",
    "downloads",
    "sidePanel"
  ],
  "minimum_chrome_version": "114",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "All in 1 Publishing Automation Tool"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "publisher-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
